* {
    margin: 0;
    padding: 0;
    box-sizing: border-box;
}

html, body {
    width: 100%;
    height: 100%;
    background-color: #000000 !important;
    overflow: hidden;
    font-family: 'Courier New', monospace;
    touch-action: none;
    margin: 0;
    padding: 0;
}

#game-container {
    width: 100vw;
    height: 100vh;
    display: flex;
    justify-content: center;
    align-items: center;
    background-color: #000000;
}

canvas {
    display: block;
    max-width: 100%;
    max-height: 100%;
    background-color: #000000;
}